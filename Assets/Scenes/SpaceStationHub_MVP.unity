  entrySubtitleText: {fileID: 1241757988}
  classificationText: {fileID: 127996715}
  bodyText: {fileID: 364338232}
  lockHintText: {fileID: 90236787}
  playerInteractor: {fileID: 214134116}
  flowController: {fileID: 595439531}
  entries:
  - category: 0
    id: CIV-001
    title: "\u6DF1\u6D77\u84DD\u9CB8"
    subtitle: "\u6D77\u6D0B\u751F\u6001 / \u65D7\u8230\u7269\u79CD"
    classification: BIOSPHERE // OCEAN
    body: "\u5730\u7403\u4E0A\u4F53\u578B\u6700\u5927\u7684\u751F\u547D\uFF0C\u4E5F\u662F\u6DF1\u6D77\u751F\u6001\u7F51\u7EDC\u7684\u91CD\u8981\u6307\u6807\u3002\u5B83\u4EEC\u7684\u8FC1\u5F99\u8DEF\u7EBF\u8BB0\u5F55\u7740\u6D0B\u6D41\u3001\u6E29\u5EA6\u4E0E\u98DF\u7269\u94FE\u7684\u53D8\u5316\u3002\n\n\u91CD\u5851\u8BA1\u5212\u4FDD\u7559\u4E86\u84DD\u9CB8\u57FA\u56E0\u7EC4\u3001\u58F0\u7EB9\u6863\u6848\u53CA\u8FC1\u5F99\u6A21\u578B\uFF0C\u7B49\u5F85\u6D77\u6D0B\u73AF\u5883\u91CD\u65B0\u5177\u5907\u627F\u8F7D\u5927\u578B\u9CB8\u7C7B\u7684\u6761\u4EF6\u3002"
    unlockStage: 0
  - category: 0
    id: CIV-014
    title: "\u94F6\u674F\u79CD\u6E90"
    subtitle: "\u690D\u7269\u6587\u660E / \u6D3B\u5316\u77F3"
    classification: BIOSPHERE // FLORA
    body: "\u94F6\u674F\u8DE8\u8D8A\u6F2B\u957F\u5730\u8D28\u5E74\u4EE3\u5B58\u7EED\u81F3\u4ECA\uFF0C\u62E5\u6709\u51FA\u8272\u7684\u73AF\u5883\u9002\u5E94\u529B\u3002\u5B83\u65E2\u662F\u57CE\u5E02\u8BB0\u5FC6\u7684\u4E00\u90E8\u5206\uFF0C\u4E5F\u662F\u690D\u7269\u6F14\u5316\u53F2\u7684\u6D3B\u6863\u6848\u3002\n\n\u79CD\u8D28\u5E93\u4FDD\u5B58\u4E86\u6765\u81EA\u4E0D\u540C\u7EAC\u5EA6\u7684\u6837\u672C\uFF0C\u4F5C\u4E3A\u5730\u8868\u690D\u88AB\u6062\u590D\u7684\u957F\u671F\u5019\u9009\u7269\u79CD\u3002"
    unlockStage: 0
  - category: 0
    id: CIV-027
    title: "\u73CA\u745A\u7901\u751F\u6001"
    subtitle: "\u6D77\u6D0B\u751F\u6001 / \u751F\u7269\u57CE\u5E02"
    classification: BIOSPHERE // REEF
    body: "\u73CA\u745A\u7901\u5360\u636E\u7684\u6D77\u57DF\u6709\u9650\uFF0C\u5374\u5E87\u62A4\u7740\u6781\u9AD8\u6BD4\u4F8B\u7684\u6D77\u6D0B\u7269\u79CD\u3002\u6E29\u5EA6\u3001\u9178\u78B1\u5EA6\u4E0E\u5FAE\u751F\u7269\u7FA4\u843D\u5FC5\u987B\u540C\u65F6\u7A33\u5B9A\uFF0C\u73CA\u745A\u624D\u53EF\u80FD\u91CD\u5EFA\u3002\n\n\u8F68\u9053\u5DE1\u68C0\u6062\u590D\u540E\uFF0C\u7A7A\u95F4\u7AD9\u91CD\u65B0\u53D6\u5F97\u4E86\u9002\u5408\u73CA\u745A\u751F\u6001\u6295\u653E\u7684\u6D77\u57DF\u5019\u9009\u6570\u636E\u3002"
    unlockStage: 1
  - category: 0
    id: CIV-036
    title: "\u6388\u7C89\u8702\u7FA4"
    subtitle: "\u9646\u5730\u751F\u6001 / \u5173\u952E\u534F\u4F5C\u8005"
    classification: BIOSPHERE // POLLINATOR
    body: "\u8702\u7FA4\u5E76\u975E\u5B64\u7ACB\u7269\u79CD\uFF0C\u800C\u662F\u5F00\u82B1\u690D\u7269\u4E0E\u519C\u4E1A\u7CFB\u7EDF\u4E4B\u95F4\u7684\u8FDE\u63A5\u8005\u3002\u6062\u590D\u6388\u7C89\u7F51\u7EDC\uFF0C\u610F\u5473\u7740\u8BA9\u690D\u7269\u7FA4\u843D\u91CD\u65B0\u62E5\u6709\u81EA\u6211\u7E41\u884D\u80FD\u529B\u3002\n\n\u751F\u6001\u6295\u653E\u5B8C\u6210\u540E\uFF0C\u8702\u7FA4\u884C\u4E3A\u6A21\u578B\u4E0E\u6297\u9006\u79CD\u7FA4\u8D44\u6599\u5DF2\u89E3\u9664\u5C01\u5B58\u3002"
    unlockStage: 1
  - category: 0
    id: CIV-052
    title: "\u6C34\u7A3B\u79CD\u8D28"
    subtitle: "\u519C\u4E1A\u6587\u660E / \u4E3B\u7CAE\u57FA\u56E0\u5E93"
    classification: CIVILIZATION // AGRICULTURE
    body: "\u6C34\u7A3B\u627F\u8F7D\u7740\u4EBA\u7C7B\u5B9A\u5C45\u3001\u704C\u6E89\u4E0E\u5B63\u8282\u534F\u4F5C\u7684\u5171\u540C\u8BB0\u5FC6\u3002\u6863\u6848\u540C\u65F6\u4FDD\u5B58\u8010\u76D0\u3001\u8010\u65F1\u53CA\u9AD8\u6D77\u62D4\u54C1\u7CFB\uFF0C\u7528\u4E8E\u9002\u914D\u4FEE\u590D\u540E\u7684\u591A\u6837\u5730\u8868\u73AF\u5883\u3002\n\n\u57FA\u56E0\u57F9\u80B2\u94FE\u8DEF\u6062\u590D\u540E\uFF0C\u8BE5\u79CD\u8D28\u5305\u53EF\u8FDB\u5165\u4E0B\u4E00\u8F6E\u6D3B\u6027\u8BC4\u4F30\u3002"
    unlockStage: 2
  - category: 0
    id: CIV-078
    title: "\u5730\u8863\u5148\u950B\u7FA4\u843D"
    subtitle: "\u6781\u7AEF\u751F\u6001 / \u7B2C\u4E00\u6279\u5B9A\u5C45\u8005"
    classification: BIOSPHERE // PIONEER
    body: "\u5730\u8863\u80FD\u591F\u5728\u8D2B\u7620\u8868\u9762\u7F13\u6162\u5206\u89E3\u5CA9\u77F3\u3001\u79EF\u7D2F\u6709\u673A\u8D28\uFF0C\u4E3A\u540E\u7EED\u690D\u7269\u7FA4\u843D\u521B\u9020\u6700\u521D\u7684\u571F\u58E4\u6761\u4EF6\u3002\n\n\u4E09\u6761\u4FEE\u590D\u94FE\u8DEF\u5168\u90E8\u901A\u8FC7\u540E\uFF0C\u5148\u950B\u7FA4\u843D\u65B9\u6848\u88AB\u5217\u4E3A\u5730\u8868\u590D\u82CF\u7684\u7B2C\u4E00\u6279\u957F\u671F\u6295\u653E\u5019\u9009\u3002"
    unlockStage: 3
  - category: 1
    id: OFF-001
    title: "\u7B2C001\u4EFB \xB7 \u9996\u4EFB\u5B88\u671B\u8005"
    subtitle: "\u5730\u7403\u91CD\u5851\u8BA1\u5212\u521D\u59CB\u8BB0\u5F55"
    classification: PERSONNEL // FOUNDING ARCHIVE
    body: "\u9996\u4EFB\u4FEE\u590D\u5B98\u5EFA\u7ACB\u4E86\u8DE8\u4E16\u7EAA\u4EA4\u63A5\u5236\u5EA6\uFF0C\u5C06\u5730\u7403\u73AF\u5883\u76D1\u6D4B\u3001\u79CD\u8D28\u4FDD\u5B58\u4E0E\u8F68\u9053\u8BBE\u65BD\u7EF4\u62A4\u5199\u5165\u540C\u4E00\u4EFD\u957F\u671F\u534F\u8BAE\u3002\n\n\u5176\u8EAB\u4EFD\u8D44\u6599\u5DF2\u968F\u65E9\u671F\u8FC1\u79FB\u8BB0\u5F55\u53D7\u635F\uFF0C\u4F46\u7559\u4E0B\u7684\u7B2C\u4E00\u6761\u539F\u5219\u4ECD\u88AB\u6BCF\u4E00\u4EFB\u4FEE\u590D\u5B98\u6CBF\u7528\uFF1A\u4FEE\u590D\u4E0D\u662F\u4E00\u6B21\u884C\u52A8\uFF0C\u800C\u662F\u4E00\u4EE3\u4EE3\u4EBA\u7684\u63A5\u529B\u3002"
    unlockStage: 0
  - category: 1
    id: OFF-077
    title: "\u7B2C077\u4EFB \xB7 \u7956\u7236\u6863\u6848"
    subtitle: "\u661F\u9645\u8FC1\u5F99\u89C1\u8BC1\u8005 / \u5BB6\u65CF\u4EA4\u63A5\u8BB0\u5F55"
    classification: PERSONNEL // LEGACY ARCHIVE
    body: "\u7B2C\u4E03\u5341\u4E03\u4EFB\u4FEE\u590D\u5B98\u4EB2\u5386\u4E86\u8FC1\u5F99\u5E74\u4EE3\u7684\u5173\u952E\u9636\u6BB5\u3002\u6863\u6848\u4E2D\u65E2\u6709\u8BFA\u4E9A\u661F\u751F\u6D3B\u7247\u6BB5\uFF0C\u4E5F\u6709\u4ED6\u5BF9\u5730\u7403\u65E7\u57CE\u5E02\u3001\u5B66\u6821\u4E0E\u5BB6\u5EAD\u8BB0\u5FC6\u7684\u53E3\u8FF0\u3002\n\n\u8FD9\u4E9B\u8D44\u6599\u5E76\u4E0D\u8981\u6C42\u6211\u4EEC\u7ACB\u523B\u5EFA\u9020\u53E6\u4E00\u5EA7\u57CE\u5E02\uFF1B\u5B83\u4EEC\u9996\u5148\u4F5C\u4E3A\u7406\u89E3\u4FEE\u590D\u5B98\u4E3A\u4F55\u575A\u6301\u8FD4\u56DE\u5730\u7403\u7684\u60C5\u611F\u8BC1\u636E\u88AB\u4FDD\u5B58\u3002"
    unlockStage: 2
  - category: 1
    id: OFF-078
    title: "\u7B2C078\u4EFB \xB7 \u7236\u4EB2\u6863\u6848"
    subtitle: "\u4E0A\u4E00\u4EFB\u4FEE\u590D\u5B98 / \u6700\u540E\u4EFB\u52A1\u8BB0\u5F55"
    classification: PERSONNEL // RESTRICTED
    body: "\u4E0A\u4E00\u4EFB\u4FEE\u590D\u5B98\u5728\u4E09\u5E74\u524D\u7684\u9AD8\u8F90\u5C04\u89C2\u6D4B\u4EFB\u52A1\u4E2D\u5931\u8054\u3002\u7A7A\u95F4\u7AD9\u4FDD\u7559\u4E86\u4ED6\u7684\u4EFB\u52A1\u6E05\u5355\u3001\u73AF\u5883\u8BFB\u6570\u4E0E\u672A\u5B8C\u6210\u7684\u4EA4\u63A5\u7559\u8A00\u3002\n\n\u5F53\u4E09\u6761\u6838\u5FC3\u4FEE\u590D\u94FE\u8DEF\u91CD\u65B0\u8FDE\u901A\u540E\uFF0C\u6700\u540E\u4E00\u6BB5\u8BB0\u5F55\u88AB\u89E3\u5BC6\uFF1A\u4ED6\u6CA1\u6709\u8981\u6C42\u7EE7\u4EFB\u8005\u590D\u5236\u81EA\u5DF1\u7684\u9053\u8DEF\uFF0C\u53EA\u5E0C\u671B\u5730\u7403\u518D\u6B21\u6210\u4E3A\u4EBA\u7C7B\u53EF\u4EE5\u9009\u62E9\u56DE\u53BB\u7684\u5BB6\u3002"
    unlockStage: 3
