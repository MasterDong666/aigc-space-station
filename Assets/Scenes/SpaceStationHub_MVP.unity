  closeButton: {fileID: 1962118944}
  puzzleButton: {fileID: 276840495}
  noahPlanetSprite: {fileID: 21300000, guid: 1ac23d417762c4404be3c75396508a53, type: 3}
  schoolCitySprite: {fileID: 21300000, guid: 50c606c9a03824be58215bfe5d280973, type: 3}
  sisterPortraitSprite: {fileID: 21300000, guid: 3cd4dae19bdb34b0083b6241e5a9ff0f,
    type: 3}
  playerInteractor: {fileID: 214134116}
  archiveController: {fileID: 255684554}
  beats:
  - speaker: "\u7CFB\u7EDF"
    line: "\u91CF\u5B50\u4E2D\u7EE7\u6821\u6B63\u5B8C\u6210\u3002\u8BFA\u4E9A\u661F\u5730\u8868\u901A\u8BAF\u5DF2\u63A5\u5165\u3002"
    visual: 0
    showPuzzleAction: 0
  - speaker: "\u59B9\u59B9"
    line: "\u59D0\uFF01\u5B66\u6821\u521A\u4E0B\u8BFE\u3002\u4ECA\u5929\u4ECE\u6559\u5BA4\u671B\u51FA\u53BB\uFF0C\u8BFA\u4E9A\u7684\u5929\u7A7A\u7279\u522B\u4EAE\u3002"
    visual: 1
    showPuzzleAction: 0
  - speaker: "\u59B9\u59B9"
    line: "\u8001\u5E08\u8BB2\u5230\u5730\u7403\u66FE\u7ECF\u6709\u771F\u6B63\u7684\u68EE\u6797\u548C\u6210\u7FA4\u7684\u52A8\u7269\u3002\u8F68\u9053\u5E93\u91CC\u8FD8\u4FDD\u5B58\u7740\u5B83\u4EEC\u7684\u6570\u636E\u5417\uFF1F"
    visual: 1
    showPuzzleAction: 1
  - speaker: "\u7B2C079\u4EFB\u4FEE\u590D\u5B98"
    line: "\u8FD8\u5728\u3002\u57FA\u56E0\u3001\u751F\u6001\u548C\u6587\u660E\u8BB0\u5F55\u90FD\u5728\u7B49\u6211\u4EEC\u91CD\u65B0\u63A5\u901A\u3002\u7B49\u4FEE\u590D\u5B8C\u6210\uFF0C\u6211\u5E26\u4F60\u4EB2\u773C\u53BB\u770B\u3002"
    visual: 1
    showPuzzleAction: 0
  - speaker: "\u59B9\u59B9"
    line: "\u8BF4\u597D\u4E86\u3002\u5BF9\u4E86\uFF0C\u6211\u628A\u7238\u7238\u548C\u7237\u7237\u7559\u4E0B\u7684\u4FEE\u590D\u5B98\u6863\u6848\u53D1\u7ED9\u4F60\u4E86\u3002\u522B\u603B\u4E00\u4E2A\u4EBA\u625B\u7740\u3002"
    visual: 1
    showPuzzleAction: 0
  - speaker: "\u7CFB\u7EDF"
    line: "\u5BB6\u65CF\u52A0\u5BC6\u5305\u63A5\u6536\u5B8C\u6210\uFF1A\u7B2C077\u4EFB\u4E0E\u7B2C078\u4EFB\u4FEE\u590D\u5B98\u6863\u6848\u5DF2\u89E3\u9501\u3002"
    visual: 0
    showPuzzleAction: 0
  onPuzzleRequested:
    m_PersistentCalls:
      m_Calls: []
